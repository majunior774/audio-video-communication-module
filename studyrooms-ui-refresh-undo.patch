+}
+
+.vc-header {
+  background: #1c2224;
+  border-bottom-color: rgba(255, 255, 255, 0.08);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+
+.vc-header__room-pill,
+.vc-header__center {
+  background: #252c2e;
+  border-color: rgba(255, 255, 255, 0.09);
+  backdrop-filter: none;
+}
+
+.vc-header__hash,
+.vc-header__count svg,
+.vc-tools__option--active svg {
+  color: var(--sr-secondary);
+}
+
+.vc-main--panels {
+  gap: 14px;
+  padding: 14px;
+}
+
+.vc-tile {
+  border-radius: 10px;
+  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.25);
+}
+
+.vc-tile:hover {
+  border-color: rgba(150, 176, 159, 0.5);
+  box-shadow: 0 7px 22px rgba(0, 0, 0, 0.32);
+}
+
+.vc-solo__radar {
+  display: none;
+}
+
+.vc-solo__overlay {
+  background: rgba(19, 24, 26, 0.72);
+  backdrop-filter: blur(1px);
+  -webkit-backdrop-filter: blur(1px);
+}
+
+.vc-solo__copy-btn {
+  background: #2b3335;
+  border-color: rgba(255, 255, 255, 0.14);
+  box-shadow: none;
+}
+
+.vc-solo__copy-btn:hover {
+  background: #343e40;
+  border-color: rgba(150, 176, 159, 0.48);
+}
+
+.vc-bar {
+  background: linear-gradient(to top, rgba(18, 23, 25, 0.84), rgba(18, 23, 25, 0.28) 70%, transparent);
+}
+
+.vc-bar__inner {
+  gap: 8px;
+  padding: 7px 10px;
+  border-color: rgba(255, 255, 255, 0.1);
+  border-radius: 14px;
+  background: #252c2e;
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.38);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+
+.vc-btn {
+  border-radius: 10px;
+  background: #30383a;
+}
+
+.vc-btn:hover {
+  background: #3a4446;
+  border-color: rgba(255, 255, 255, 0.12);
+}
+
+.vc-tools__dropdown {
+  border-color: rgba(255, 255, 255, 0.12);
+  border-radius: 12px;
+  background: #252c2e;
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+
+.vc-tools__option--active {
+  background: rgba(150, 176, 159, 0.16);
+  color: #c5d7ca;
+}
+
+/* Whiteboard: paper canvas with quiet, usable controls. */
+.whiteboard {
+  --board-surface: #f2f1eb;
+  --board-surface-raised: #fbfaf6;
+  --board-surface-elevated: #ecebe4;
+  --board-border: #d8ddd5;
+  --board-text: #283430;
+  --board-muted: #6d7972;
+  --board-accent: #37695f;
+  --board-secondary: #718d7e;
+  border-radius: 12px;
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
+}
+
+.whiteboard-heading {
+  background: #f8f7f2;
+}
+
+.whiteboard-heading-mark {
+  border-color: rgba(55, 105, 95, 0.2);
+  background: rgba(55, 105, 95, 0.08);
+  color: var(--board-accent);
+  box-shadow: none;
+}
+
+.whiteboard-heading-copy h2 {
+  color: var(--board-text);
+}
+
+.whiteboard-presence {
+  border-color: #d8ddd5;
+  background: #efeee8;
+  color: #52605a;
+  backdrop-filter: none;
+}
+
+.whiteboard-close,
+.watch-together-close {
+  border-color: #d2d8d1;
+  border-radius: 8px;
+  background: #f2f1eb;
+  color: #52605a;
+}
+
+.whiteboard-close:hover,
+.watch-together-close:hover {
+  border-color: #b9c8bc;
+  background: #e9eee8;
+  color: #273a33;
+}
+
+.whiteboard-toolbar {
+  background: #fbfaf6;
+}
+
+.whiteboard-color-swatches {
+  border-right-color: #d8ddd5;
+}
+
+.whiteboard-color-swatch {
+  border-color: rgba(36, 47, 42, 0.18);
+  box-shadow: none;
+}
+
+.whiteboard-color-swatch.is-selected {
+  border-color: var(--board-accent);
+  box-shadow: 0 0 0 1px var(--board-accent);
+}
+
+.whiteboard-tool,
+.whiteboard-action {
+  border-color: #d7ddd6;
+  border-radius: 7px;
+  background: #f2f1eb;
+  color: #4d5a54;
+}
+
+.whiteboard-tool:hover:not(:disabled),
+.whiteboard-action:hover:not(:disabled) {
+  border-color: #b6c9bb;
+  background: #e9eee8;
+  color: #2e4a3f;
+}
+
+.whiteboard-tool.is-active {
+  border-color: rgba(55, 105, 95, 0.4);
+  background: rgba(55, 105, 95, 0.12);
+  color: #315d52;
+  box-shadow: none;
+}
+
+.whiteboard-setting input[type='color'],
+.whiteboard-text-size-control {
+  border-color: #d2d8d1;
+  background: #fffefa;
+  color: #4d5a54;
+}
+
+.whiteboard-size span {
+  color: #46534d;
+}
+
+.whiteboard-sync-status {
+  border-color: #d8ddd5;
+  background: rgba(255, 254, 250, 0.96);
+  color: #35443d;
+  box-shadow: 0 8px 24px rgba(32, 47, 42, 0.12);
+  backdrop-filter: none;
+}
+
+.whiteboard-canvas-wrap {
+  background: #fffefa;
+}
+
+/* Co-watching keeps the video black and its controls neutral. */
+.watch-together {
+  --watch-surface: #202628;
+  --watch-raised: #252d30;
+  --watch-elevated: #171d1f;
+  --watch-border: rgba(255, 255, 255, 0.1);
+  --watch-text: #f3f4f0;
+  --watch-muted: #a0aaa4;
+  --watch-accent: #628b7b;
+  --watch-secondary: #96b09f;
+  border-radius: 12px;
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
+}
+
+.watch-together-heading {
+  background: #252d30;
+}
+
+.watch-together-icon {
+  border-color: rgba(150, 176, 159, 0.24);
+  background: rgba(150, 176, 159, 0.12);
+  color: #b7cbbb;
+  box-shadow: none;
+}
+
+.watch-together-input-row button,
+.watch-together-play-overlay button {
+  border-color: rgba(150, 176, 159, 0.3);
+  border-radius: 8px;
+  background: #628b7b;
+  box-shadow: none;
+}
+
+.watch-together-input-row button:hover:not(:disabled),
+.watch-together-play-overlay button:hover {
+  background: #547a6b;
+}
+
+.watch-together-player {
+  background: #111617;
+}
+
+.watch-together-player:fullscreen {
+  background: #171c1e;
+}
+
+@media (max-width: 800px) {
+  .sr-landing__header,
+  .sr-landing__main,
+  .sr-landing__footer {
+    width: min(100% - 32px, 600px);
+  }
+
+  .sr-landing__hero {
+    grid-template-columns: 1fr;
+    gap: 42px;
+    padding-block: 56px 42px;
+  }
+
+  .sr-landing__intro h1 {
+    font-size: clamp(46px, 11vw, 68px);
+  }
+
+  .sr-landing__capabilities {
+    justify-content: flex-start;
+    flex-wrap: wrap;
+    padding-block: 18px;
+  }
+
+  .sr-landing__capabilities > span {
+    flex-basis: 100%;
+  }
+
+  .sr-landing__capabilities > div {
+    flex: 0 0 calc(50% - 14px);
+  }
+}
+
+@media (max-width: 520px) {
+  .sr-landing__header {
+    min-height: 68px;
+  }
+
+  .sr-landing__nav {
+    gap: 12px;
+  }
+
+  .sr-landing__nav-link {
+    font-size: 11px;
+  }
+
+  .sr-landing__nav-cta {
+    min-height: 36px;
+    padding-inline: 10px;
+    font-size: 11px;
+  }
+
+  .sr-landing__brand svg {
+    width: 26px;
+    height: 26px;
+  }
+
+  .sr-landing__brand .sr-font-heading {
+    font-size: 15px !important;
+  }
+
+  .sr-landing__lede {
+    font-size: 14px;
+  }
+
+  .sr-join-form__controls {
+    align-items: stretch;
+  }
+
+  .sr-join-form__controls > .sr-button {
+    padding-inline: 14px;
+  }
+
+  .sr-landing__guide {
+    padding: 18px 18px 10px;
+  }
+
+  .sr-landing__footer {
+    min-height: 68px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .sr-button {
+    transition: none;
+  }
+}
